{
  "name": "avmdf-deploy",
  "version": "2.5.0",
  "private": true,
  "description": "Comparaison des sources locales et de la production IIS, archivage AVMDF et mise en production assistée.",
  "author": "GUERRIN Florian",
  "main": "electron/main.js",
  "repository": "https://github.com/guerrinflorian/Saarstahl-mise-en-prod",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --publish never"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "iconv-lite": "^0.7.3",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "electron": "^22.3.27",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "fr.process.avmdf-deploy",
    "productName": "MEPFront",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json",
      "!node_modules/.bin"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "MEPFront.exe"
    },
    "nsis": {
      "artifactName": "MEPFront-Setup.exe",
      "oneClick": true,
      "perMachine": false
    }
  }
}
